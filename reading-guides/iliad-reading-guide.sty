% ILIAD teaching reading guides. A companion style for guided paper sessions.
% Compile with pdfLaTeX. No external fonts or shell escape required.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{iliad-reading-guide}[2026/09/09 ILIAD reading guides]

\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage{amsmath,amssymb}
\RequirePackage[a4paper,margin=22mm,headheight=15pt,headsep=7mm,footskip=11mm]{geometry}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\RequirePackage{xparse}
\RequirePackage[colorlinks=true]{hyperref}

\definecolor{iliadInk}{HTML}{20262A}
\definecolor{iliadAccent}{HTML}{255C6A}
\definecolor{iliadMuted}{HTML}{525D62}
\definecolor{iliadTint}{HTML}{EEF3F4}

\color{iliadInk}
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\setlist{itemsep=3pt,topsep=5pt}
\setlist[itemize,1]{leftmargin=7mm,label=\textcolor{iliadAccent}{\textbullet}}
\setlist[enumerate,1]{leftmargin=9mm,label=\arabic*.}
\hypersetup{linkcolor=iliadAccent,urlcolor=iliadAccent,citecolor=iliadAccent}

\providecommand{\iliadcourse}{Computational Mechanics}
\providecommand{\iliadpart}{Module title}
\providecommand{\iliadterm}{Autumn 2026}
\providecommand{\iliadinstitute}{ILIAD Intensive}
\providecommand{\iliadauthor}{Xavier Poncini (Simplex)}
\providecommand{\iliadhandout}{Reading guide}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\iliadcourse: \iliadpart}
\fancyhead[R]{\small\iliadhandout}
\fancyfoot[L]{\footnotesize\color{iliadMuted}\iliadinstitute\ · \iliadterm}
\fancyfoot[R]{\footnotesize\color{iliadMuted}\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{iliadfirst}{%
  \fancyhf{}
  \fancyfoot[L]{\footnotesize\color{iliadMuted}\iliadinstitute\ · \iliadterm}
  \fancyfoot[R]{\footnotesize\color{iliadMuted}\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}}

\newcommand{\makeiliadreadingtitle}{%
  \thispagestyle{iliadfirst}
  {\small\color{iliadAccent}\bfseries\iliadinstitute\hfill\iliadterm\par}
  \vspace{7mm}
  {\LARGE\bfseries\iliadcourse\par}
  \vspace{1mm}
  {\Large\iliadpart\par}
  \vspace{3mm}
  {\large\color{iliadAccent}\bfseries\iliadhandout\par}
  \vspace{1mm}
  {\small\color{iliadMuted}\iliadauthor\par}
  \vspace{3mm}
  {\color{iliadAccent}\rule{\linewidth}{0.8pt}\par}
  \vspace{1mm}}

\NewDocumentEnvironment{sessionplan}{+b}{%
  \begin{center}
    \setlength{\fboxsep}{4mm}%
    \colorbox{iliadTint}{%
      \begin{minipage}{0.91\linewidth}
        {\bfseries Session at a glance}\par\smallskip
        #1
      \end{minipage}}
  \end{center}
  \vspace{0mm}}{}

\newcommand{\guideheading}[1]{%
  \par\addvspace{4mm}{\Large\bfseries\color{iliadAccent}#1\par}\vspace{1mm}}

\NewDocumentEnvironment{reading}{O{Main} m m}{%
  \par\addvspace{5mm}
  {\small\bfseries\color{iliadAccent}[#1]\par}
  \vspace{0.5mm}
  {\large\bfseries\href{#3}{#2}\par}
  \vspace{1mm}
}{\par\addvspace{2mm}}

\NewDocumentEnvironment{readingroute}{}{
  \par{\bfseries Reading route}\par
  \begin{itemize}
}{\end{itemize}}

\newcommand{\routeitem}[2]{\item \textbf{#1.} #2}
\newcommand{\readingoverview}[1]{\par\textbf{Overview.} #1\par}
\newcommand{\guidenote}[1]{%
  \par\smallskip{\small\color{iliadMuted}\itshape #1\par}}

\endinput
